{
  "manifest_version": 3,
  "name": "No Metrics View",
  "version": "1.2.1",
  "description": "Hides viewer counts, social metrics, 7TV raid counts, bot messages, and the Go Live button on Twitch and X/Twitter.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "96": "icons/icon96.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "options_ui": {
    "page": "popup.html"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.twitch.tv/*",
        "*://x.com/*",
        "*://twitter.com/*"
      ],
      "js": ["content.js"]
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "no-metrics-view@estix.app",
      "strict_min_version": "109.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
